{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "resolveJsonModule": true
  },
  "references": [
    {
      "path": "../../packages/oot-core"
    },
    {
      "path": "../../packages/oot-content"
    },
    {
      "path": "../../packages/oot-persistence"
    },
    {
      "path": "../../packages/oot-platform"
    }
  ],
  "include": [
    "src",
    "../../content/**/*.json"
  ]
}
